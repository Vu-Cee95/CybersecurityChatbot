<Window x:Class="CybersecurityChatbotGUI.CyberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberBot"
        Width="430"
        Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#FFFFFF"
            CornerRadius="24"
            BorderBrush="#F97316"
            BorderThickness="2"
            Padding="0">

        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="3"
                              Opacity="0.28"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#3F3F46"
                    CornerRadius="22,22,0,0"
                    Padding="18,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="42"
                            Height="42"
                            Background="#F97316"
                            CornerRadius="21">

                        <TextBlock Text="🔐"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">

                        <TextBlock x:Name="DialogTitleTextBlock"
                                   Text="CyberBot"
                                   Foreground="#FFFFFF"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="#22C55E"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Secure system message"
                                       Foreground="#E5E5E5"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MESSAGE BODY -->
            <Grid Grid.Row="1"
                  Background="#FAFAFA"
                  Margin="0">

                <StackPanel VerticalAlignment="Center"
                            Margin="26,18">

                    <TextBlock x:Name="DialogMessageTextBlock"
                               Text="Message goes here."
                               Foreground="#111111"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="23"/>
                </StackPanel>
            </Grid>

            <!-- BUTTONS -->
            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    CornerRadius="0,0,22,22"
                    BorderBrush="#E5E5E5"
                    BorderThickness="0,1,0,0"
                    Padding="18">

                <StackPanel x:Name="ButtonPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="NoButton"
                            Content="No"
                            Width="92"
                            Height="38"
                            Margin="0,0,10,0"
                            Click="NoButton_Click"
                            Cursor="Hand">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#3F3F46"/>
                                <Setter Property="BorderBrush" Value="#D4D4D8"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="19">

                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E5E5"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#D4D4D8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="YesButton"
                            Content="Yes"
                            Width="92"
                            Height="38"
                            Click="YesButton_Click"
                            Cursor="Hand">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F97316"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#EA580C"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="19">

                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#EA580C"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#C2410C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>