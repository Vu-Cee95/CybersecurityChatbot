<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberBot | Cybersecurity Awareness Assistant"
        Height="700"
        Width="1050"
        MinHeight="650"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Window.Resources>

        <!-- PREMIUM ANIMATED BUTTON BASE -->
        <Style x:Key="PremiumAnimatedButtonBaseStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>

        <!-- SEND BUTTON -->
        <Style x:Key="SendIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PremiumAnimatedButtonBaseStyle}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EA580C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C2410C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D1D5DB"/>
                                <Setter Property="Opacity" Value="0.75"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- THREE DOTS BUTTON -->
        <Style x:Key="PremiumDotsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PremiumAnimatedButtonBaseStyle}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#F97316"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Ellipse Width="4.5" Height="4.5" Fill="#FFFFFF" Margin="0,0,3.5,0"/>
                                <Ellipse Width="4.5" Height="4.5" Fill="#FFFFFF" Margin="0,0,3.5,0"/>
                                <Ellipse Width="4.5" Height="4.5" Fill="#FFFFFF"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#52525B"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#EA580C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F97316"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#F97316"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D1D5DB"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PREMIUM CONTEXT MENU -->
        <Style x:Key="PremiumContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="BorderBrush" Value="#F97316"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PremiumMenuItemStyle" TargetType="MenuItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,2">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#F97316"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A1A1AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PremiumLogoutMenuItemStyle"
               TargetType="MenuItem"
               BasedOn="{StaticResource PremiumMenuItemStyle}">
            <Setter Property="Foreground" Value="#FED7AA"/>
        </Style>

        <Style x:Key="PremiumMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Background="#71717A"
                                CornerRadius="1"
                                Opacity="0.55"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WELCOME PRIMARY BUTTON -->
        <Style x:Key="WelcomePrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PremiumAnimatedButtonBaseStyle}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="23"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EA580C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C2410C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D1D5DB"/>
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SMALL PRIMARY BUTTON -->
        <Style x:Key="SmallPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PremiumAnimatedButtonBaseStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="17"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EA580C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C2410C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D1D5DB"/>
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HOME EXIT BUTTON -->
        <Style x:Key="HomeExitButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PremiumAnimatedButtonBaseStyle}">
            <Setter Property="Width" Value="86"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="BorderBrush" Value="#EA580C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EA580C"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C2410C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C2410C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D1D5DB"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SIDEBAR FEATURE BUTTON STYLE -->
        <Style x:Key="SidebarFeatureButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PremiumAnimatedButtonBaseStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#F97316"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#52525B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F97316"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PREMIUM HOVER CARD EFFECT -->
        <Style x:Key="PremiumHoverCardStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <EventSetter Event="MouseEnter" Handler="PremiumHoverCard_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="PremiumHoverCard_MouseLeave"/>
        </Style>

        <!-- SCROLLBAR -->
        <Style x:Key="ScrollNavigationButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EA580C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C2410C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D1D5DB"/>
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PremiumScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F97316"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="22" Background="Transparent" Margin="2,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <RepeatButton Grid.Row="0"
                                          Style="{StaticResource ScrollNavigationButtonStyle}"
                                          Command="ScrollBar.LineUpCommand">
                                <Path Fill="White" Width="8" Height="8" Stretch="Uniform"
                                      Data="M 0 6 L 4 0 L 8 6 Z"/>
                            </RepeatButton>
                            <Grid Grid.Row="1" Width="9" HorizontalAlignment="Center" Margin="0,5,0,5">
                                <Border Background="#E5E5E5" CornerRadius="9" Width="9" Opacity="0.8"/>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Style="{StaticResource InvisibleTrackButtonStyle}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border x:Name="ThumbBorder"
                                                            Background="#F97316"
                                                            CornerRadius="9"
                                                            Width="9"
                                                            MinHeight="34"
                                                            Opacity="0.95"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#EA580C"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#C2410C"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Style="{StaticResource InvisibleTrackButtonStyle}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <RepeatButton Grid.Row="2"
                                          Style="{StaticResource ScrollNavigationButtonStyle}"
                                          Command="ScrollBar.LineDownCommand">
                                <Path Fill="White" Width="8" Height="8" Stretch="Uniform"
                                      Data="M 0 0 L 4 6 L 8 0 Z"/>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- ==================== WELCOME PAGE ==================== -->
        <Grid x:Name="WelcomePage"
              Background="#F5F5F5"
              Visibility="Visible">

            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="0.92*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT WELCOME HERO -->
                <Border Grid.Column="0"
                        Background="#111111"
                        CornerRadius="30"
                        Padding="20"
                        Margin="0,0,18,0"
                        BorderBrush="#F97316"
                        BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="56"
                                        Height="56"
                                        Background="#F97316"
                                        CornerRadius="28">
                                    <TextBlock Text="&#x1F6E1;"
                                               FontSize="28"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="#1F1F1F"
                                        CornerRadius="16"
                                        BorderBrush="#F97316"
                                        BorderThickness="2"
                                        Padding="10,7"
                                        VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="WelcomeOnlineDot"
                                                 Width="8" Height="8"
                                                 Fill="#22C55E"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 RenderTransformOrigin="0.5,0.5"/>
                                        <TextBlock Text="Secure Assistant Online"
                                                   Foreground="#FFFFFF"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="Welcome to CyberBot"
                                       Foreground="#FFFFFF"
                                       FontSize="29"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="Your Cybersecurity Awareness Assistant"
                                       Foreground="#D4D4D4"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Learn how to protect yourself from scams, phishing attacks, weak passwords, privacy risks and unsafe browsing."
                                       Foreground="#E5E5E5"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,0,0,12"/>
                        </StackPanel>

                        <!-- ASCII ART -->
                        <Border Grid.Row="1"
                                Background="#1F1F1F"
                                CornerRadius="20"
                                Padding="8"
                                BorderBrush="#F97316"
                                BorderThickness="2"
                                Height="162"
                                Margin="0,0,0,12">
                            <Grid ClipToBounds="True">
                                <Viewbox Stretch="Uniform"
                                         StretchDirection="DownOnly"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <TextBlock x:Name="WelcomeAsciiTextBlock"
                                               Foreground="#F97316"
                                               FontFamily="Consolas"
                                               FontSize="8.6"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               LineHeight="10"
                                               TextWrapping="NoWrap"
                                               xml:space="preserve">=======================================================================
  ██████╗██╗   ██╗██████╗ ███████╗██████╗    ██████╗  ██████╗ ████████╗
 ██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗   ██╔══██╗██╔═══██╗╚══██╔══╝
 ██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝   ██████╔╝██║   ██║   ██║   
 ██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗   ██╔══██╗██║   ██║   ██║   
 ╚██████╗   ██║   ██████╔╝███████╗██║  ██║   ██████╔╝╚██████╔╝   ██║   
  ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝   ╚═════╝  ╚═════╝    ╚═╝   
=======================================================================

Your friendly cybersecurity awareness chatbot</TextBlock>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- FEATURE CARDS -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource PremiumHoverCardStyle}"
                                    Background="#FFFFFF"
                                    CornerRadius="15"
                                    Padding="10"
                                    MinHeight="76">
                                <StackPanel>
                                    <TextBlock Text="&#x1F511;" FontSize="18" Margin="0,0,0,4"/>
                                    <TextBlock Text="Password Safety"
                                               Foreground="#111111"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="Create stronger passwords."
                                               Foreground="#525252"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               LineHeight="13"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource PremiumHoverCardStyle}"
                                    Background="#FFFFFF"
                                    CornerRadius="15"
                                    Padding="10"
                                    MinHeight="76">
                                <StackPanel>
                                    <TextBlock Text="&#x1F3A3;" FontSize="18" Margin="0,0,0,4"/>
                                    <TextBlock Text="Phishing Awareness"
                                               Foreground="#111111"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="Spot fake links and scams."
                                               Foreground="#525252"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               LineHeight="13"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Style="{StaticResource PremiumHoverCardStyle}"
                                    Background="#FFFFFF"
                                    CornerRadius="15"
                                    Padding="10"
                                    MinHeight="76">
                                <StackPanel>
                                    <TextBlock Text="&#x1F6E1;" FontSize="18" Margin="0,0,0,4"/>
                                    <TextBlock Text="Privacy Protection"
                                               Foreground="#111111"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="Keep your data private."
                                               Foreground="#525252"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               LineHeight="13"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- EXIT AND NOTE -->
                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#FFF3E8"
                                    CornerRadius="15"
                                    Padding="10">
                                <TextBlock Text="Built for cybersecurity awareness and safer online behaviour."
                                           Foreground="#9A3412"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <Button x:Name="ExitApplicationButton"
                                    Grid.Row="2"
                                    Content="EXIT"
                                    Style="{StaticResource HomeExitButtonStyle}"
                                    Click="ExitApplicationButton_Click"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT LOGIN CARD -->
                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        CornerRadius="30"
                        Padding="34"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Background="#FFF3E8"
                                    CornerRadius="16"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16">
                                <TextBlock Text="&#x1F512; Protected Learning Session"
                                           Foreground="#9A3412"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>

                            <TextBlock Text="Start your secure session"
                                       Foreground="#111111"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       LineHeight="36"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Enter your name so CyberBot can personalise your cybersecurity guidance during this session."
                                       Foreground="#6B7280"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       LineHeight="21"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="Your name"
                                       Foreground="#111111"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                            <Border Background="#F5F5F5"
                                    CornerRadius="24"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    Padding="4"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock x:Name="WelcomeNamePlaceholderTextBlock"
                                               Text="Enter your name here..."
                                               Foreground="#6B7280"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="15,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <TextBox x:Name="WelcomeNameTextBox"
                                             Height="46"
                                             FontSize="15"
                                             FontWeight="SemiBold"
                                             Padding="15,0"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             Foreground="#111111"
                                             BorderThickness="0"
                                             KeyDown="WelcomeNameTextBox_KeyDown"
                                             TextChanged="WelcomeNameTextBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="WelcomeValidationTextBlock"
                                       Text="Name must be at least 3 characters and include at least one letter."
                                       Foreground="#6B7280"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="2,0,0,16"/>

                            <Button x:Name="StartChatButton"
                                    Content="&#x1F510; Start Secure Chat"
                                    Style="{StaticResource WelcomePrimaryButtonStyle}"
                                    Click="StartChatButton_Click"
                                    IsEnabled="False"/>

                            <TextBlock Text="Press Enter or click Start Secure Chat."
                                       Foreground="#6B7280"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="2"
                                Background="#FAFAFA"
                                CornerRadius="18"
                                Padding="14"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="&#x1F4CB; Session Note"
                                           Foreground="#111111"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="CyberBot will only use your name to make this chat feel more personal and easier to follow."
                                           Foreground="#6B7280"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== CHAT PAGE ==================== -->
        <Grid x:Name="ChatPage"
              Background="#F5F5F5"
              Visibility="Collapsed"
              Opacity="0"
              Margin="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR WITH SCROLL -->
                <Border Grid.Column="0"
                        Background="#111111"
                        CornerRadius="24"
                        Padding="16"
                        Margin="0,0,16,0"
                        BorderBrush="#F97316"
                        BorderThickness="1">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource PremiumScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                        <StackPanel>
                            <Border x:Name="SidebarLogoBorder"
                                    Width="56" Height="56"
                                    Background="#F97316"
                                    CornerRadius="28"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="#F97316"
                                                      BlurRadius="12"
                                                      ShadowDepth="0"
                                                      Opacity="0.6"/>
                                </Border.Effect>
                                <TextBlock Text="&#x1F6E1;"
                                           FontSize="27"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="CyberBot"
                                       Foreground="#FFFFFF"
                                       FontSize="25" FontWeight="Bold"
                                       Margin="0,0,0,2"/>

                            <TextBlock Text="Cybersecurity Assistant"
                                       Foreground="#D4D4D4"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap" LineHeight="16"
                                       Margin="0,0,0,14"/>

                            <!-- SESSION INFO -->
                            <Border x:Name="SessionInfoBorder"
                                    Background="#1F1F1F"
                                    CornerRadius="16" Padding="12"
                                    BorderBrush="#22C55E" BorderThickness="1"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="8" Height="8" Fill="#22C55E"
                                                 Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Session Active"
                                                   Foreground="#FFFFFF"
                                                   FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SessionUserTextBlock"
                                               Text="User: Not set"
                                               Foreground="#E5E5E5"
                                               FontSize="12" FontWeight="Bold"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SessionLastTopicTextBlock"
                                               Text="Last topic: None"
                                               Foreground="#E5E5E5"
                                               FontSize="12" FontWeight="Bold"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SessionMoodTextBlock"
                                               Text="Mood: Not detected"
                                               Foreground="#E5E5E5"
                                               FontSize="12" FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- PART 3 FEATURE BUTTONS -->
                            <TextBlock Text="Features"
                                       Foreground="#FFFFFF"
                                       FontSize="13.5" FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                            <Button x:Name="TasksButton"
                                    Style="{StaticResource SidebarFeatureButtonStyle}"
                                    Click="TasksButton_Click" Margin="0,0,0,6">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4CB;" Margin="0,0,8,0"/>
                                        <TextBlock Text="Task Assistant"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button x:Name="QuizButton"
                                    Style="{StaticResource SidebarFeatureButtonStyle}"
                                    Click="QuizButton_Click" Margin="0,0,0,6">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F3AE;" Margin="0,0,8,0"/>
                                        <TextBlock Text="Cyber Quiz"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button x:Name="ActivityLogButton"
                                    Style="{StaticResource SidebarFeatureButtonStyle}"
                                    Click="ActivityLogButton_Click" Margin="0,0,0,12">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4CA;" Margin="0,0,8,0"/>
                                        <TextBlock Text="Activity Log"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <!-- ASK ABOUT TOPICS -->
                            <TextBlock Text="Ask about:"
                                       Foreground="#FFFFFF"
                                       FontSize="13.5" FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                            <Border Style="{StaticResource PremiumHoverCardStyle}"
                                    Background="#FFFFFF" CornerRadius="14"
                                    Padding="9" Margin="0,0,0,6">
                                <TextBlock Text="&#x1F511; Password safety"
                                           Foreground="#111111"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource PremiumHoverCardStyle}"
                                    Background="#FFFFFF" CornerRadius="14"
                                    Padding="9" Margin="0,0,0,6">
                                <TextBlock Text="&#x1F3A3; Phishing scams"
                                           Foreground="#111111"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource PremiumHoverCardStyle}"
                                    Background="#FFFFFF" CornerRadius="14"
                                    Padding="9" Margin="0,0,0,6">
                                <TextBlock Text="&#x1F6E1; Privacy protection"
                                           Foreground="#111111"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource PremiumHoverCardStyle}"
                                    Background="#FFFFFF" CornerRadius="14"
                                    Padding="9" Margin="0,0,0,6">
                                <TextBlock Text="&#x1F310; Safe browsing"
                                           Foreground="#111111"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource PremiumHoverCardStyle}"
                                    Background="#FFFFFF" CornerRadius="14"
                                    Padding="9" Margin="0,0,0,12">
                                <TextBlock Text="&#x1F4F1; 2FA and malware"
                                           Foreground="#111111"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                            </Border>

                            <!-- TIP -->
                            <Border Background="#FFF3E8" CornerRadius="15" Padding="11">
                                <TextBlock Text="Try: Add task or Start quiz."
                                           Foreground="#9A3412"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- MAIN CONTENT AREA WITH TABS -->
                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        CornerRadius="24"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1">

                    <Grid>
                        <!-- ==================== CHAT TAB ==================== -->
                        <Grid x:Name="ChatTab" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="76"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFFFFF"
                                    CornerRadius="24,24,0,0"
                                    BorderBrush="#E5E5E5" BorderThickness="0,0,0,1"
                                    Padding="18,12">
                                <Grid VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="HeaderBotAvatarBorder"
                                            Grid.Column="0" Width="42" Height="42"
                                            Background="#F97316" CornerRadius="21"
                                            RenderTransformOrigin="0.5,0.5">
                                        <TextBlock Text="&#x1F916;" FontSize="22"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="CyberBot" Foreground="#111111"
                                                   FontSize="18" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ChatOnlineDot" Width="7" Height="7"
                                                     Fill="#22C55E" Margin="0,0,6,0"
                                                     RenderTransformOrigin="0.5,0.5"/>
                                            <TextBlock Text="Online" Foreground="#6B7280"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="&#x1F512; Secure Chat"
                                               Foreground="#F97316" FontSize="12"
                                               FontWeight="Bold" VerticalAlignment="Center"/>

                                    <Button x:Name="MenuDotsButton" Grid.Column="4"
                                            Style="{StaticResource PremiumDotsButtonStyle}"
                                            Click="MenuDotsButton_Click" ToolTip="Chat options">
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="ChatOptionsContextMenu"
                                                         Style="{StaticResource PremiumContextMenuStyle}">
                                                <MenuItem Header="&#x2753; Help"
                                                          Style="{StaticResource PremiumMenuItemStyle}"
                                                          Click="HelpMenuItem_Click"/>
                                                <Separator Style="{StaticResource PremiumMenuSeparatorStyle}"/>
                                                <MenuItem Header="&#x1F504; Start New Chat"
                                                          Style="{StaticResource PremiumMenuItemStyle}"
                                                          Click="NewChatMenuItem_Click"/>
                                                <Separator Style="{StaticResource PremiumMenuSeparatorStyle}"/>
                                                <MenuItem Header="&#x1F6AA; Log Out"
                                                          Style="{StaticResource PremiumLogoutMenuItemStyle}"
                                                          Click="LogoutMenuItem_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="#FAFAFA"
                                    BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
                                <ScrollViewer x:Name="ChatScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Padding="18">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="{x:Type ScrollBar}"
                                               BasedOn="{StaticResource PremiumScrollBarStyle}"/>
                                    </ScrollViewer.Resources>
                                    <StackPanel x:Name="ChatPanel"/>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Row="2" Background="#FFFFFF" Padding="18,3">
                                <Border x:Name="TypingIndicatorBorder" Background="#FFF3E8"
                                        CornerRadius="15" Padding="12,7"
                                        HorizontalAlignment="Left"
                                        Visibility="Collapsed" Opacity="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TypingIndicatorTextBlock" Text=""
                                                   Foreground="#9A3412" FontSize="12"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="TypingDot1" Width="6" Height="6"
                                                     Fill="#F97316" Margin="0,0,4,0"
                                                     RenderTransformOrigin="0.5,0.5"/>
                                            <Ellipse x:Name="TypingDot2" Width="6" Height="6"
                                                     Fill="#F97316" Margin="0,0,4,0"
                                                     RenderTransformOrigin="0.5,0.5"/>
                                            <Ellipse x:Name="TypingDot3" Width="6" Height="6"
                                                     Fill="#F97316" RenderTransformOrigin="0.5,0.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>

                            <Border Grid.Row="3" Background="#FFFFFF"
                                    CornerRadius="0,0,24,24" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="InputOuterBorder" Grid.Column="0"
                                            Background="#F5F5F5" CornerRadius="24"
                                            BorderBrush="#DDDDDD" BorderThickness="1" Padding="4">
                                        <Grid>
                                            <TextBlock x:Name="PlaceholderTextBlock"
                                                       Text="&#x1F4AC; Type your cybersecurity question here..."
                                                       Foreground="#6B7280" FontSize="14"
                                                       FontWeight="SemiBold" Margin="15,0,0,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            <TextBox x:Name="UserInputTextBox" Height="44"
                                                     FontSize="14" FontWeight="SemiBold"
                                                     Padding="15,0" VerticalContentAlignment="Center"
                                                     Background="Transparent" Foreground="#111111"
                                                     BorderThickness="0"
                                                     KeyDown="UserInputTextBox_KeyDown"
                                                     GotFocus="UserInputTextBox_GotFocus"
                                                     LostFocus="UserInputTextBox_LostFocus"
                                                     TextChanged="UserInputTextBox_TextChanged"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0"
                                            Style="{StaticResource SendIconButtonStyle}"
                                            Click="SendButton_Click" IsEnabled="False"
                                            ToolTip="Send message">
                                        <Viewbox Width="20" Height="20">
                                            <Path Fill="White" Stretch="Uniform"
                                                  Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ==================== TASK ASSISTANT TAB ==================== -->
                        <Grid x:Name="TaskTab" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFFFFF"
                                    CornerRadius="24,24,0,0"
                                    BorderBrush="#E5E5E5" BorderThickness="0,0,0,1"
                                    Padding="18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Task Assistant"
                                                   Foreground="#111111" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="Manage your cybersecurity tasks"
                                                   Foreground="#6B7280" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Back to Chat"
                                            Style="{StaticResource SmallPrimaryButtonStyle}"
                                            Click="BackToChatButton_Click" Width="120"/>
                                </Grid>
                            </Border>

                            <!-- SCROLLABLE CONTENT -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource PremiumScrollBarStyle}"/>
                                </ScrollViewer.Resources>

                                <StackPanel>
                                    <!-- ADD TASK SECTION -->
                                    <Border Background="#FAFAFA" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Add New Task"
                                                       Foreground="#111111" FontSize="16"
                                                       FontWeight="Bold" Margin="0,0,0,10"/>
                                            <TextBlock Text="Task Title"
                                                       Foreground="#111111" FontSize="12"
                                                       FontWeight="Bold" Margin="0,0,0,4"/>
                                            <Border Background="#F5F5F5" CornerRadius="24"
                                                    BorderBrush="#DDDDDD" BorderThickness="1"
                                                    Padding="4" Margin="0,0,0,8">
                                                <TextBox x:Name="TaskTitleTextBox"
                                                         Height="44" FontSize="14"
                                                         FontWeight="SemiBold" Padding="15,0"
                                                         VerticalContentAlignment="Center"
                                                         Background="Transparent" Foreground="#111111"
                                                         BorderThickness="0"/>
                                            </Border>
                                            <TextBlock Text="Description (optional)"
                                                       Foreground="#111111" FontSize="12"
                                                       FontWeight="Bold" Margin="0,0,0,4"/>
                                            <Border Background="#F5F5F5" CornerRadius="24"
                                                    BorderBrush="#DDDDDD" BorderThickness="1"
                                                    Padding="4" Margin="0,0,0,8">
                                                <TextBox x:Name="TaskDescriptionTextBox"
                                                         Height="60" FontSize="14"
                                                         FontWeight="SemiBold" Padding="15,8"
                                                         VerticalContentAlignment="Top"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         Background="Transparent" Foreground="#111111"
                                                         BorderThickness="0"/>
                                            </Border>
                                            <TextBlock Text="Reminder (optional: in 3 days, in 2 weeks, tomorrow)"
                                                       Foreground="#111111" FontSize="12"
                                                       FontWeight="Bold" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F5F5F5"
                                                        CornerRadius="24" BorderBrush="#DDDDDD"
                                                        BorderThickness="1" Padding="4"
                                                        Margin="0,0,8,0">
                                                    <TextBox x:Name="TaskReminderTextBox"
                                                             Height="44" FontSize="14"
                                                             FontWeight="SemiBold" Padding="15,0"
                                                             VerticalContentAlignment="Center"
                                                             Background="Transparent" Foreground="#111111"
                                                             BorderThickness="0"/>
                                                </Border>
                                                <Button x:Name="AddTaskButton" Grid.Column="1"
                                                        Content="Add Task"
                                                        Style="{StaticResource SmallPrimaryButtonStyle}"
                                                        Click="AddTaskButton_Click" Width="100"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- TASK LIST SECTION -->
                                    <Border Background="White" Padding="16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Your Tasks"
                                                           Foreground="#111111" FontSize="16" FontWeight="Bold"/>
                                                <Button x:Name="RefreshTasksButton" Grid.Column="1"
                                                        Content="Refresh"
                                                        Style="{StaticResource SmallPrimaryButtonStyle}"
                                                        Click="RefreshTasksButton_Click" Width="80"/>
                                            </Grid>
                                            <StackPanel x:Name="TaskListPanel"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ==================== QUIZ TAB ==================== -->
                        <Grid x:Name="QuizTab" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFFFFF"
                                    CornerRadius="24,24,0,0"
                                    BorderBrush="#E5E5E5" BorderThickness="0,0,0,1"
                                    Padding="18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Cybersecurity Quiz"
                                                   Foreground="#111111" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock x:Name="QuizProgressTextBlock"
                                                   Text="Test your knowledge"
                                                   Foreground="#6B7280" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Back to Chat"
                                            Style="{StaticResource SmallPrimaryButtonStyle}"
                                            Click="BackToChatButton_Click" Width="120"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="White" Padding="24">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="{x:Type ScrollBar}"
                                               BasedOn="{StaticResource PremiumScrollBarStyle}"/>
                                    </ScrollViewer.Resources>
                                    <Grid>
                                        <StackPanel x:Name="QuizStartPanel"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center" MinHeight="350">
                                            <TextBlock Text="Test Your Cybersecurity Knowledge"
                                                       Foreground="#111111" FontSize="24"
                                                       FontWeight="Bold" TextAlignment="Center"
                                                       Margin="0,0,0,10"/>
                                            <TextBlock Text="10 questions covering phishing, passwords, safe browsing, and more."
                                                       Foreground="#6B7280" FontSize="14"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       Margin="0,0,0,20"/>
                                            <Button x:Name="StartQuizButton" Content="Start Quiz"
                                                    Style="{StaticResource WelcomePrimaryButtonStyle}"
                                                    Click="StartQuizButton_Click"
                                                    Width="160" Height="44" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel x:Name="QuizActivePanel" Visibility="Collapsed">
                                            <TextBlock x:Name="QuizQuestionTextBlock"
                                                       Foreground="#111111" FontSize="18"
                                                       FontWeight="Bold" TextWrapping="Wrap"
                                                       Margin="0,0,0,16"/>
                                            <StackPanel x:Name="QuizOptionsPanel" Margin="0,0,0,16"/>
                                            <TextBlock x:Name="QuizFeedbackTextBlock" Text=""
                                                       Foreground="#6B7280" FontSize="14"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Margin="0,0,0,12" Visibility="Collapsed"/>
                                            <Button x:Name="QuizNextButton" Content="Next Question"
                                                    Style="{StaticResource SmallPrimaryButtonStyle}"
                                                    Click="QuizNextButton_Click"
                                                    Width="140" HorizontalAlignment="Center"
                                                    Visibility="Collapsed" Margin="0,20,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="QuizResultsPanel"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="Collapsed" MinHeight="350">
                                            <TextBlock x:Name="QuizResultsTitleTextBlock"
                                                       Foreground="#111111" FontSize="24"
                                                       FontWeight="Bold" TextAlignment="Center"
                                                       Margin="0,0,0,10"/>
                                            <TextBlock x:Name="QuizResultsScoreTextBlock"
                                                       Foreground="#F97316" FontSize="36"
                                                       FontWeight="Bold" TextAlignment="Center"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock x:Name="QuizResultsFeedbackTextBlock"
                                                       Foreground="#6B7280" FontSize="14"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       Margin="0,0,0,20"/>
                                            <Button x:Name="QuizRetryButton" Content="Try Again"
                                                    Style="{StaticResource WelcomePrimaryButtonStyle}"
                                                    Click="StartQuizButton_Click"
                                                    Width="140" Height="40" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- ==================== ACTIVITY LOG TAB ==================== -->
                        <Grid x:Name="ActivityLogTab" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFFFFF"
                                    CornerRadius="24,24,0,0"
                                    BorderBrush="#E5E5E5" BorderThickness="0,0,0,1"
                                    Padding="18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Activity Log"
                                                   Foreground="#111111" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock x:Name="ActivityCountTextBlock"
                                                   Text="Tracked actions in this session"
                                                   Foreground="#6B7280" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Back to Chat"
                                            Style="{StaticResource SmallPrimaryButtonStyle}"
                                            Click="BackToChatButton_Click" Width="120"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="White" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Recent Actions"
                                                   Foreground="#111111" FontSize="16" FontWeight="Bold"/>
                                        <Button x:Name="RefreshLogButton" Grid.Column="1"
                                                Content="Refresh"
                                                Style="{StaticResource SmallPrimaryButtonStyle}"
                                                Click="RefreshLogButton_Click" Width="80"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ActivityLogPanel"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>

            <!-- CONFETTI OVERLAY -->
            <Canvas x:Name="ConfettiCanvas"
                    Grid.Row="0" Grid.RowSpan="2"
                    IsHitTestVisible="False" Visibility="Collapsed"/>

            <!-- BOTTOM TAB NAVIGATION BAR -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="16"
                    Padding="8" Margin="0,10,0,0"
                    BorderBrush="#E5E5E5" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="NavChatButton" Width="110" Height="34"
                            Margin="0,0,6,0" FontSize="12" FontWeight="Bold"
                            Click="NavChatButton_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4AC;" Margin="0,0,6,0"/>
                                <TextBlock Text="Chat"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F97316"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="12" Padding="12,6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="NavTasksButton" Width="110" Height="34"
                            Margin="0,0,6,0" FontSize="12" FontWeight="Bold"
                            Click="NavTasksButton_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4CB;" Margin="0,0,6,0"/>
                                <TextBlock Text="Tasks"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="#111111"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="12" Padding="12,6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="NavQuizButton" Width="110" Height="34"
                            Margin="0,0,6,0" FontSize="12" FontWeight="Bold"
                            Click="NavQuizButton_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F3AE;" Margin="0,0,6,0"/>
                                <TextBlock Text="Quiz"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="#111111"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="12" Padding="12,6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="NavLogButton" Width="110" Height="34"
                            FontSize="12" FontWeight="Bold"
                            Click="NavLogButton_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4CA;" Margin="0,0,6,0"/>
                                <TextBlock Text="Log"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#E5E5E5"/>
                                <Setter Property="Foreground" Value="#111111"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="12" Padding="12,6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- PREMIUM LOADING OVERLAY -->
        <Grid x:Name="LoadingOverlay"
              Background="#99000000"
              Visibility="Collapsed" Opacity="0">
            <Border x:Name="LoadingCardBorder" Width="380"
                    Background="#FFFFFF" CornerRadius="28" Padding="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                        <TranslateTransform Y="18"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel>
                    <Border x:Name="LoadingShieldIconBorder"
                            Width="66" Height="66" Background="#F97316"
                            CornerRadius="33" HorizontalAlignment="Center"
                            Margin="0,0,0,16" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <TextBlock Text="&#x1F6E1;" FontSize="31"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Preparing your secure session"
                               Foreground="#111111" FontSize="22"
                               FontWeight="Bold" TextAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="LoadingStatusTextBlock"
                               Text="Setting up CyberBot."
                               Foreground="#6B7280" FontSize="13"
                               FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="Wrap" LineHeight="20"
                               Margin="0,0,0,16"/>
                    <Border Height="9" Background="#E5E5E5"
                            CornerRadius="5" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="LoadingProgressBar"
                                    Width="90" Height="9" Background="#F97316"
                                    CornerRadius="5" HorizontalAlignment="Left"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-100"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="&#x1F6E1; Smart risk detection &#x2022; Secure awareness &#x2022; Professional guidance"
                               Foreground="#9A3412" FontSize="11.5"
                               FontWeight="Bold" TextAlignment="Center"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>