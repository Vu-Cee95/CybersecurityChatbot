<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber-Bot GUI - Part 2"
        Height="720"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
                Background="#0F172A"
                CornerRadius="18"
                Padding="20"
                Margin="0,0,18,0">

            <StackPanel>
                <TextBlock Text="Cyber-Bot"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Cybersecurity Awareness Assistant"
                           Foreground="#CBD5E1"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,0,0,25"/>

                <Border Background="#1E293B"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,20">
                    <TextBlock Text="🔐&#x0a;Stay Alert.&#x0a;Stay Secure.&#x0a;Stay Cyber Safe."
                               Foreground="#38BDF8"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               LineHeight="30"/>
                </Border>

                <TextBlock Text="You can ask me about:"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock Text="• Password safety&#x0a;• Phishing scams&#x0a;• Privacy protection&#x0a;• Safe browsing&#x0a;• Suspicious links"
                           Foreground="#CBD5E1"
                           FontSize="14"
                           LineHeight="25"/>

                <Border Background="#1E293B"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,30,0,0">
                    <TextBlock Text="Tip: Try typing 'I am worried about scams' or 'Tell me about password safety'."
                               Foreground="#E2E8F0"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- MAIN CHAT PANEL -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="18"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Chat with Cyber-Bot"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Learn how to protect yourself online through a friendly cybersecurity conversation."
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- CHAT DISPLAY -->
                <Border Grid.Row="1"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="15">

                    <ScrollViewer x:Name="ChatScrollViewer"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatPanel"/>
                    </ScrollViewer>
                </Border>

                <!-- INPUT AREA -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UserInputTextBox"
                             Grid.Column="0"
                             Height="45"
                             FontSize="15"
                             Padding="12"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Background="White"
                             Foreground="#0F172A"
                             KeyDown="UserInputTextBox_KeyDown"/>

                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Content="Send"
                            Height="45"
                            Margin="10,0,0,0"
                            Background="#0F172A"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="SendButton_Click"/>

                    <Button x:Name="HelpButton"
                            Grid.Column="2"
                            Content="Help"
                            Height="45"
                            Margin="10,0,0,0"
                            Background="#0284C7"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="HelpButton_Click"/>

                    <Button x:Name="ClearButton"
                            Grid.Column="3"
                            Content="Clear"
                            Height="45"
                            Margin="10,0,0,0"
                            Background="#E2E8F0"
                            Foreground="#0F172A"
                            FontSize="14"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="ClearButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>